<?xml version="1.0" encoding="UTF-8"?>

<!-- One build of Install another build, before it is installed: tags (its
     kind, its checks, installed or new), its title, a card of facts (built,
     size, commit, branch, checksum, when GitHub deletes it), what installing
     does, Install and See on GitHub (a QR code), then its notes or
     description. Filled by dev_build_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playshelf/dev_build/open"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Box id="dbd_tags" width="auto" height="auto" axis="row" marginBottom="10"/>
            <aurore:Label id="dbd_headline" text="" fontSize="26" marginBottom="16"/>
            <aurore:Box id="dbd_facts" width="auto" height="auto" axis="column" alignItems="stretch"
                paddingTop="6" paddingBottom="6" paddingLeft="24" paddingRight="24"
                marginBottom="14"/>
            <aurore:Label id="dbd_warning" text="" fontSize="18" marginBottom="18" textColor="@theme/cadran/text3"/>
            <aurore:Box width="auto" height="auto" axis="row">
                <aurore:Button id="dbd_install" style="primary" text="@i18n/playshelf/dev_build/install" grow="1.0" marginRight="12"/>
                <aurore:Button id="dbd_github" style="default" text="@i18n/playshelf/dev_build/open_github"/>
            </aurore:Box>
            <aurore:Header id="dbd_notes_header" marginTop="32" marginBottom="8"/>
            <aurore:Box id="dbd_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
