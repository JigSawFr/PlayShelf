<?xml version="1.0" encoding="UTF-8"?>

<!-- The full list of changes in the running version (the bundled
     CHANGELOG.md), opened from the highlights on "What's new".
     Filled by changelog_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Header id="cl_header" marginBottom="8"/>
            <aurore:Box id="cl_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="cl_note" text="" fontSize="20" marginTop="16" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
