<?xml version="1.0" encoding="UTF-8"?>

<!-- Shown when what PlayShelf needs from the console cannot be opened
     (typically: no custom firmware). B exits. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:Box
        title="@i18n/playshelf/init_error/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        justifyContent="center"
        alignItems="center"
        grow="1.0"
        paddingLeft="60"
        paddingRight="60">

        <brls:Label
            text="@i18n/playshelf/init_error/headline"
            fontSize="28"
            horizontalAlign="center"
            marginBottom="20"/>

        <brls:Label
            id="error_code"
            text="—"
            fontSize="20"
            horizontalAlign="center"
            marginBottom="12"
            textColor="@theme/cadran/text3"/>

        <brls:Label
            id="error_fw"
            text=""
            fontSize="20"
            horizontalAlign="center"
            marginBottom="32"
            textColor="@theme/cadran/text3"/>

        <brls:Label
            text="@i18n/playshelf/init_error/body"
            horizontalAlign="center"/>

    </brls:Box>

</brls:AppletFrame>
