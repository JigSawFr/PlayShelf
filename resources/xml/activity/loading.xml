<?xml version="1.0" encoding="UTF-8"?>

<!-- The loading screen (activity/loading_activity.hpp), in the brand colours of
     the store banner, Cadran's dial on the right (the light theme: its cool white, the wordmark and the
     bar in its inks, LoadingActivity::onContentAvailable): the icon with its
     ring turning, the wordmark, the tagline, and a progress bar over the
     start-up steps. -->

<brls:Box
    id="loading_root"
    width="auto"
    height="auto"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="#0B1424">

    <!-- Cadran's dial on the right, behind the rest (as the PIN gate's). -->
    <LoadingDial
        id="loading_dial"
        width="1280"
        height="720"
        positionType="absolute"
        positionTop="0"
        positionLeft="0"/>

    <LoadingMark
        width="168"
        height="168"
        marginBottom="40"/>

    <brls:Image
        id="loading_wordmark"
        image="@res/img/wordmark.png"
        width="360"
        height="88"/>

    <brls:Label
        id="loading_tagline"
        text="@i18n/playshelf/loading/tagline"
        fontSize="22"
        horizontalAlign="center"
        textColor="#A9B5C9"
        marginBottom="64"/>

    <LoadingBar
        id="loading_bar"
        width="420"
        height="8"
        marginBottom="18"/>

    <brls:Label
        id="loading_step"
        text=" "
        fontSize="18"
        horizontalAlign="center"
        textColor="#A9B5C9"/>

    <!-- Holds the focus while this screen is the top one (nothing to press
         here): pushed over it, the first screen hands it back to a view of
         this screen, which outlives every other start screen. -->
    <brls:Rectangle
        id="loading_anchor"
        width="1"
        height="1"
        color="#0B1424"
        focusable="true"
        hideHighlight="true"/>

</brls:Box>
