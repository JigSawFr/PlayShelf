<?xml version="1.0" encoding="UTF-8"?>

<!-- What's new: shown once at start-up after an update (action/support_flow),
     the running version's highlights and a cell to the full list (or the
     full list when it has none), then how to support PlayShelf. Filled by whats_new_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Header id="wn_header" marginBottom="8"/>
            <aurore:Box id="wn_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:DetailCell id="wn_full" title="@i18n/playshelf/about/changelog_full" marginTop="12"/>
            <aurore:DetailCell id="wn_close" title="@i18n/playshelf/about/whats_new_close" marginTop="24"/>
            <aurore:Header title="@i18n/playshelf/about/section_support" marginTop="32" marginBottom="8"/>
            <aurore:Label text="@i18n/playshelf/about/support_note" id="wn_support_note" fontSize="20" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Box id="wn_funding" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <MadeInFrance marginTop="24"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
