<?xml version="1.0" encoding="UTF-8"?>

<!-- Library › a server, added or changed: its name and addresses (on this
     network, over the Internet), which one to use, whether this console is
     paired with it; Save and Delete. Filled by source/activity/server_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.png"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch">

            <aurore:Header title="@i18n/playshelf/library/section_server" marginBottom="8"/>
            <aurore:DetailCell id="sv_name" title="@i18n/playshelf/library/name"/>
            <aurore:DetailCell id="sv_lan" title="@i18n/playshelf/library/lan_url"/>
            <aurore:DetailCell id="sv_wan" title="@i18n/playshelf/library/wan_url"/>
            <aurore:DetailCell id="sv_connection" title="@i18n/playshelf/library/connection"/>
            <aurore:Header title="@i18n/playshelf/pairing/section" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="sv_pairing" title="@i18n/playshelf/pairing/state"/>
            <aurore:DetailCell id="sv_save" title="@i18n/playshelf/library/save" marginTop="24"/>
            <aurore:DetailCell id="sv_delete" title="@i18n/playshelf/library/delete" marginTop="12"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
