<?xml version="1.0" encoding="UTF-8"?>

<!-- Library › Downloads: the queue, each job's name, its state and its
     progress (with the speed and the time left for the running one); A on
     one gives what can be done with it; whether the console stays awake
     while they run. Filled by
     source/activity/downloads_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="dl_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <!-- Dressed by its own code: the screens' skin leaves it alone. -->
            <brls:Box id="cadran_list" width="auto" height="auto" visibility="gone"/>
            <brls:Box id="dl_empty" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Box id="dl_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:BooleanCell id="dl_keep_awake" marginTop="12"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
