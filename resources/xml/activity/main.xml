<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen: a rail of tabs (cadran::style_rail gives it its icons:
     activity/screen_hooks.cpp), each tab a custom view registered in
     main.cpp and implemented in source/tab/. Their positions:
     activity/tabs.hpp. -->

<aurore:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <aurore:TabFrame
        id="main_tabs"
        title="@i18n/playshelf/title"
        icon="@res/img/app_icon.jpg">

        <aurore:Tab label="@i18n/playshelf/tabs/home">
            <HomeTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playshelf/tabs/library">
            <LibraryTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playshelf/tabs/catalogue">
            <CatalogueTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playshelf/tabs/downloads">
            <DownloadsTab/>
        </aurore:Tab>

        <aurore:Separator/>

        <aurore:Tab label="@i18n/playshelf/tabs/preferences">
            <PreferencesTab/>
        </aurore:Tab>

        <aurore:Tab label="@i18n/playshelf/tabs/about">
            <AboutTab/>
        </aurore:Tab>

    </aurore:TabFrame>

</aurore:AppletFrame>
