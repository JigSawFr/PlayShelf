<?xml version="1.0" encoding="UTF-8"?>

<!-- A newer PlayShelf: at start-up (action/update_flow) or after Check for
     updates. Update, the way it is installed, Later, then the new version's
     notes. Filled by update_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playshelf/update/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left">

            <aurore:Label id="up_headline" text="" fontSize="26" marginBottom="12"/>
            <aurore:Label id="up_body" text="" fontSize="20" marginBottom="16" textColor="@theme/cadran/text3"/>
            <aurore:DetailCell id="up_update"/>
            <aurore:DetailCell id="up_method" title="@i18n/playshelf/tools/update_via"/>
            <aurore:DetailCell id="up_later" title="@i18n/playshelf/common/later"/>
            <aurore:Header id="up_notes_header" marginTop="32" marginBottom="8"/>
            <aurore:Box id="up_notes" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Label id="up_notes_none" text="" fontSize="20" textColor="@theme/cadran/text3"/>

        </aurore:Box>

    </ScrollView>

</aurore:AppletFrame>
