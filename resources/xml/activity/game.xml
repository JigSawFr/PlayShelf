<?xml version="1.0" encoding="UTF-8"?>

<!-- A game's page (the Catalogue's, the Library's): its banner; its icon,
     name, facts and chips; its tabs (Overview, Updates, Add-ons, Details),
     each a pane shown alone. Overview: what it is about, its lines, its
     screenshots, its description, more games like it. What Nlib API knows
     of it fills in once it answers. Filled by
     source/activity/game_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            id="gp_column"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <!-- The banner, once it came, with the head laid over its lower part. -->
            <brls:Box id="gp_hero" width="auto" height="auto" axis="column" alignItems="stretch" marginBottom="18">
                <brls:Box id="gp_head" width="auto" height="auto" axis="row" alignItems="flexEnd"/>
            </brls:Box>
            <brls:Box id="gp_tabs" width="auto" height="auto" axis="row" marginBottom="20"/>

            <brls:Box id="gp_overview" width="auto" height="auto" axis="column" alignItems="stretch">
                <brls:Label id="gp_intro" text="" fontSize="20" marginBottom="20" visibility="gone"
                    textColor="@theme/cadran/text2"/>
                <brls:Box id="gp_lines" width="auto" height="auto" axis="column" alignItems="stretch"/>
                <brls:Header id="gp_screens_header" title="@i18n/playshelf/game/screenshots" marginTop="24" marginBottom="8"
                    visibility="gone"/>
                <brls:Box id="gp_screens" width="auto" height="auto" axis="column" alignItems="flexStart"/>
                <brls:Header id="gp_about_header" title="@i18n/playshelf/game/about" marginTop="24" marginBottom="8"
                    visibility="gone"/>
                <brls:Label id="gp_description" text="" fontSize="18" visibility="gone"/>
                <brls:Box id="gp_others" width="auto" height="auto" axis="column" alignItems="stretch"/>
            </brls:Box>
            <brls:Box id="gp_updates" width="auto" height="auto" axis="column" alignItems="stretch" visibility="gone"/>
            <brls:Box id="gp_dlcs" width="auto" height="auto" axis="column" alignItems="stretch" visibility="gone"/>
            <brls:Box id="gp_details" width="auto" height="auto" axis="column" alignItems="stretch" visibility="gone"/>

            <brls:Label id="gp_source" text="@i18n/playshelf/game/source" fontSize="15" marginTop="16"
                visibility="gone" textColor="@theme/cadran/text3"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
