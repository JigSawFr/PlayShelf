<?xml version="1.0" encoding="UTF-8"?>

<!-- Developer mode: the diagnostic report on screen, in focusable chunks so the
     D-pad scrolls through it. Y saves it. Filled by source/activity/diagnostic_activity.cpp. -->

<aurore:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playshelf/dev/report_title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <aurore:Box
            id="dg_list"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/sidebar/padding_top"
            paddingRight="@style/aurore/sidebar/padding_right"
            paddingBottom="@style/aurore/sidebar/padding_bottom"
            paddingLeft="@style/aurore/sidebar/padding_left"/>

    </ScrollView>

</aurore:AppletFrame>
