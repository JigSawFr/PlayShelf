<?xml version="1.0" encoding="UTF-8"?>

<!-- About › Help & diagnostics: the diagnostic report (export, send
     online, and the GitHub account it is sent with) and how many reports are
     kept, then (once enabled by seven presses on About › Version) the
     developer tools. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header title="@i18n/playshelf/tools/section_start" marginBottom="8"/>
            <!-- A tile: sending a report (cadran::List::tiles). -->
            <aurore:DetailCell id="hp_upload" title="@i18n/playshelf/tiles/upload"/>
            <aurore:Label id="hp_upload_note" text="@i18n/playshelf/tools/upload_note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Header title="@i18n/playshelf/tools/section_diag" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="hp_export" title="@i18n/playshelf/tools/export"/>
            <aurore:DetailCell id="hp_github" title="@i18n/playshelf/github/account"/>
            <aurore:DetailCell id="hp_mode" focusable="false" title="@i18n/playshelf/tools/mode"/>
            <aurore:DetailCell id="hp_data" focusable="false" title="@i18n/playshelf/tools/data"/>
            <aurore:Label id="hp_export_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Header title="@i18n/playshelf/tools/section_reports" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="hp_logs_keep" title="@i18n/playshelf/tools/logs_keep"/>
            <aurore:DetailCell id="hp_logs_keep_days" title="@i18n/playshelf/tools/logs_keep_days"/>
            <aurore:DetailCell id="hp_logs_keep_mb" title="@i18n/playshelf/tools/logs_keep_mb"/>
            <aurore:Label id="hp_logs_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Header id="hp_dev_header" title="@i18n/playshelf/dev/section" marginTop="24" marginBottom="8"/>
            <aurore:BooleanCell id="hp_dev_mode"/>
            <aurore:BooleanCell id="hp_dev_read_only"/>
            <aurore:BooleanCell id="hp_dev_frame_stats"/>
            <aurore:Label id="hp_dev_frame_stats_note" text="@i18n/playshelf/dev/frame_stats_note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Label id="hp_dev_frame_stats_last" fontSize="18" marginBottom="10" textColor="@theme/cadran/text3"/>
            <aurore:BooleanCell id="hp_dev_glow"/>
            <aurore:DetailCell id="hp_dev_clear_cache" title="@i18n/playshelf/dev/clear_cache"/>
            <aurore:DetailCell id="hp_dev_clear_logs" title="@i18n/playshelf/dev/clear_logs"/>
            <aurore:DetailCell id="hp_dev_report" title="@i18n/playshelf/dev/report"/>
            <aurore:DetailCell id="hp_dev_build" title="@i18n/playshelf/dev_build/open"/>
            <aurore:DetailCell id="hp_dev_install" title="@i18n/playshelf/install/from_url"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
