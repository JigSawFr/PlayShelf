<?xml version="1.0" encoding="UTF-8"?>

<!-- Homebrew: the homebrew a library server offers (tab/homebrew_tab.cpp): a
     line saying where the reading stands, then one cell each. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Label id="hb_status" text=" " fontSize="18" marginBottom="12" textColor="@theme/cadran/text3"/>
            <aurore:Box id="hb_list" width="auto" height="auto" axis="column" alignItems="stretch"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
