<?xml version="1.0" encoding="UTF-8"?>

<!-- About: the installed PlayShelf and help with it. Its card first (the
     mark, the name, the version), then the version (Ⓐ opens every version's
     release notes, on a screen of their own; seven presses of a hidden Ⓨ
     turn the developer tools on, at the end of Help & diagnostics, below)
     and checking for updates now (every day and how: Preferences); a line
     to Help & diagnostics (tab/help.xml, on a screen of its own, with the
     launch mode and the data folder); the credits and the licence, in one
     dialog; how to support it (QR codes of the funding links, Ⓐ shows one
     larger), and "Made in France". -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header title="@i18n/playshelf/tools/section_about" marginBottom="8"/>
            <aurore:DetailCell id="ab_version" title="@i18n/playshelf/tools/version"/>
            <aurore:DetailCell id="ab_update" title="@i18n/playshelf/tools/update"/>
            <aurore:DetailCell id="ab_help" title="@i18n/playshelf/prefs/help" marginTop="24"/>
            <aurore:DetailCell id="ab_boreale" title="@i18n/playshelf/about/boreale"/>
            <aurore:DetailCell id="ab_credits" title="@i18n/playshelf/about/credits_open" marginTop="24"/>
            <aurore:Header title="@i18n/playshelf/about/section_support" marginTop="24" marginBottom="8"/>
            <aurore:Label id="ab_support_note" text="@i18n/playshelf/about/support_note" fontSize="20" marginBottom="6" textColor="@theme/cadran/text3"/>
            <aurore:Box id="ab_funding" width="auto" height="auto" axis="row" justifyContent="spaceEvenly" marginTop="8"/>
            <MadeInFrance marginTop="32" marginBottom="8"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
