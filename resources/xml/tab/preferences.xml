<?xml version="1.0" encoding="UTF-8"?>

<!-- Preferences: only what sets PlayShelf itself up — the app (language,
     theme, text size and start tab as tiles first, the palette, the effects,
     the intro),
     the monthly "Support PlayShelf" reminder, how it updates and the title
     database (the names and icons every tab falls back on). A setting
     that shapes one feature sits with it; Help & diagnostics is in About. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Header title="@i18n/playshelf/prefs/section_app" marginBottom="8"/>
            <aurore:DetailCell id="pf_language" title="@i18n/playshelf/tools/language"/>
            <aurore:DetailCell id="pf_theme" title="@i18n/playshelf/tools/theme"/>
            <aurore:DetailCell id="pf_text_size" title="@i18n/playshelf/tiles/text_size"/>
            <aurore:DetailCell id="pf_start_tab" title="@i18n/playshelf/tiles/start_tab"/>
            <aurore:DetailCell id="pf_palette" title="@i18n/cadran/tools/palette"/>
            <aurore:DetailCell id="pf_effects" title="@i18n/playshelf/prefs/effects"/>
            <aurore:BooleanCell id="pf_intro"/>
            <aurore:BooleanCell id="pf_support_reminder"/>
            <aurore:Header title="@i18n/playshelf/tools/section_update" marginTop="24" marginBottom="8"/>
            <aurore:BooleanCell id="pf_update_daily"/>
            <aurore:DetailCell id="pf_update_via" title="@i18n/playshelf/tools/update_via"/>
            <aurore:Header title="@i18n/playshelf/titledb/section" marginTop="24" marginBottom="8"/>
            <aurore:DetailCell id="pf_titledb" title="@i18n/playshelf/titledb/row"/>
            <aurore:DetailCell id="pf_title_sources" title="@i18n/playshelf/titledb/sources"/>
            <aurore:BooleanCell id="pf_nlib_api"/>
            <aurore:BooleanCell id="pf_popular_online"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
