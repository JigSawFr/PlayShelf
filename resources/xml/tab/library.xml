<?xml version="1.0" encoding="UTF-8"?>

<!-- Library: the games on the console (tab/library_tab.cpp). With none, an
     empty state; else a line saying how many and how many the catalogues
     have more of (A reads them again), tiles counting them (A on one
     filters by it), the games with something to get as wide banners, then
     the games as a grid of covers
     (a page at a time, "Show more" after it). -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            id="li_content"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:DetailCell id="li_summary" title="@i18n/playshelf/installed/summary"/>
            <brls:Box id="li_stats" width="auto" height="auto" axis="row" marginTop="12" visibility="gone"/>
            <brls:Box id="li_featured" width="auto" height="auto" axis="column" alignItems="stretch" visibility="gone"/>
            <brls:DetailCell id="li_filter" title="@i18n/playshelf/filters/row_sort" marginTop="12" visibility="gone"/>
            <brls:Box id="li_empty" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="12"/>
            <brls:Box id="li_grid" width="auto" height="auto" axis="column" alignItems="flexStart" marginTop="8"/>
            <brls:Box id="li_list" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="12"/>
            <brls:Button id="li_more" style="default" text="@i18n/playshelf/library/show_more" marginTop="16"
                width="320" alignSelf="center"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
