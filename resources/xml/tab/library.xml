<?xml version="1.0" encoding="UTF-8"?>

<!-- Library: the games on the console (tab/library_tab.cpp). With none, an
     empty state; else a line saying how many and how many the catalogues
     have more of (A reads them again), then the games as a grid of covers
     (a page at a time, "Show more" after it). -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            id="li_content"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <!-- How many games (A: read them again) and the order and filters,
                 as pills (view/tool_chip, made in code). -->
            <aurore:Box id="li_bar" width="auto" height="auto" axis="row"/>
            <aurore:Box id="li_empty" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="12"/>
            <aurore:Box id="li_grid" width="auto" height="auto" axis="column" alignItems="flexStart" marginTop="8"/>
            <aurore:Box id="li_list" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="12"/>
            <aurore:Button id="li_more" style="default" text="@i18n/playshelf/library/show_more" marginTop="16"
                width="320" alignSelf="center"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
