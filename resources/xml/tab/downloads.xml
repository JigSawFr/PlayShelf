<?xml version="1.0" encoding="UTF-8"?>

<!-- Downloads: the queue by game, each game's icon, state and timeline of
     its packages; A on one gives what can be done with it; whether the
     console stays awake while they run, and a download's connections. Filled by
     source/tab/downloads_tab.cpp. -->

<aurore:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

            <aurore:Box id="dl_empty" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="40"/>
            <aurore:Box id="dl_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <aurore:Box id="dl_settings" width="auto" height="auto" axis="column" alignItems="stretch" marginTop="12"/>

        </aurore:Box>

    </ScrollView>

</aurore:Box>
