{
  "name": "PlayShelf simulator",
  "short_name": "PlayShelf",
  "description": "PlayShelf running in the browser against a simulated console and a demo library server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a1020",
  "theme_color": "#111d31",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "shortcuts": [
    {
      "name": "The demo shelf's catalogue",
      "short_name": "Catalogue",
      "url": "./?tab=catalogue",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "A slow network",
      "short_name": "Slow network",
      "url": "./?speed=16",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "No library server yet",
      "short_name": "No server",
      "url": "./?no_demo=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "The guided tour",
      "short_name": "Tour",
      "url": "./?tour=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
